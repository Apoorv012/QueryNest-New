# QueryNest Configuration
# Copy this file to .env and fill in your values.

# PostgreSQL connection string (Supabase pooler or local)
# Format: postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
QUERYNEST_DATABASE_URL=

# Storage mode: "supabase" or "local"
QUERYNEST_STORAGE_MODE=supabase
