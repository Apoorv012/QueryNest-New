# QueryNest Configuration
# Copy this file to .env and fill in your values.

# Storage mode: "local" (Postgres in Docker) or "supabase" (hosted)
QUERYNEST_STORAGE_MODE=local

# Hosted Postgres — used ONLY when QUERYNEST_STORAGE_MODE=supabase
# Format: postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
QUERYNEST_DATABASE_URL=

# Local Postgres — used ONLY when QUERYNEST_STORAGE_MODE=local
# Port 5433, not 5432: a natively-installed PostgreSQL service may already own
# 5432 and will answer ahead of the container, producing a confusing
# "password authentication failed" against correct credentials.
# Start it with:
#   docker run -d --name querynest-pg \
#     -e POSTGRES_USER=querynest -e POSTGRES_PASSWORD=querynest \
#     -e POSTGRES_DB=querynest -p 5433:5432 pgvector/pgvector:pg17
# The two variables are kept separate on purpose: "local" mode must never be
# able to fall through to the hosted connection string.
QUERYNEST_LOCAL_DATABASE_URL=postgresql://querynest:querynest@localhost:5433/querynest
